{
  "name": "react-native-android-navigation-mode",
  "version": "1.0.1",
  "description": "React Native Android module to detect navigation mode: gesture, 2-button, or 3-button.",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "files": [
    "android",
    "src",
    "README.md",
    "CHANGELOG.md",
    "react-native.config.js",
    "app.plugin.js",
    "!android/build",
    "!android/.gradle",
    "!android/.cxx",
    "!android/src/test",
    "!**/__tests__"
  ],
  "expo": {
    "plugin": "./app.plugin.js"
  },
  "scripts": {
    "test": "jest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/__tests__"
    ],
    "testMatch": [
      "**/*.test.js"
    ]
  },
  "keywords": [
    "react-native",
    "android",
    "navigation-bar",
    "gesture",
    "native-module",
    "expo",
    "expo-plugin"
  ],
  "author": "minhla",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luongminh2410dev/react-native-android-navigation-mode.git"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.71"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "typescript": "^7.0.2"
  }
}
