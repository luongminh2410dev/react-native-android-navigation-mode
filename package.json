{
  "name": "react-native-android-navigation-mode",
  "version": "1.1.0",
  "description": "Detect the Android navigation mode (gesture, 2-button, 3-button) synchronously and read navigation bar insets. TurboModule for the New Architecture, works on the Legacy Architecture and Expo dev builds.",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "files": [
    "android",
    "src",
    "README.md",
    "CHANGELOG.md",
    "react-native.config.js",
    "app.plugin.js",
    "!android/build",
    "!android/.gradle",
    "!android/.cxx",
    "!android/src/test",
    "!**/__tests__"
  ],
  "expo": {
    "plugin": "./app.plugin.js"
  },
  "codegenConfig": {
    "name": "RNAndroidNavigationModeSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.reactnativeandroidnavigationmode"
    }
  },
  "scripts": {
    "test": "jest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.codegen-spec.json"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/__tests__"
    ],
    "testMatch": [
      "**/*.test.js"
    ]
  },
  "keywords": [
    "react-native",
    "android",
    "navigation-mode",
    "navigation-bar",
    "navigation-bar-height",
    "gesture-navigation",
    "window-insets",
    "edge-to-edge",
    "turbo-module",
    "new-architecture",
    "native-module",
    "expo",
    "expo-plugin"
  ],
  "author": "minhla",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luongminh2410dev/react-native-android-navigation-mode.git"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.71"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-native": "^0.88.1",
    "react-test-renderer": "^18.3.1",
    "typescript": "^7.0.2"
  }
}
